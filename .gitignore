# Python environments / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
runs/

# pytest --basetemp scratch. Rework implementers use .tmp/ for red/green runs and the
# directories stay locked while a run is live, which makes `git status` warn as well as
# offering the tree a chance to swallow them. Never commit them.
.tmp/

# Secrets — never in repo
.env
.env.*

# Environment MCP servers write their logs into cwd (see evidence/SESSION-001/preflight-report.md §A3)
cad_mcp.log
mcp_*.log

# OS noise
Thumbs.db
Desktop.ini
