{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoworld-automation.local/schemas/scene_geometry/v1/scene_geometry-1.0.0.schema.json",
  "title": "scene_geometry",
  "$defs": {
    "point2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
  },
  "allOf": [
    { "$ref": "https://panoworld-automation.local/schemas/envelope/v1/envelope-1.0.0.schema.json" },
    {
      "properties": {
        "schema_id": { "const": "scene_geometry" },
        "schema_version": { "const": "1.0.0" },
        "payload": {
          "type": "object",
          "required": ["units", "up_axis", "default_ceiling_height_m", "rooms", "walls"],
          "properties": {
            "units": { "const": "m" },
            "up_axis": { "const": "z", "$comment": "PanoWorld demo data is Z-up (verified, panoworld-compat #2); locked until an ADR changes it." },
            "default_ceiling_height_m": { "type": "number", "exclusiveMinimum": 0 },
            "rooms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "polygon"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string" },
                  "polygon": { "type": "array", "minItems": 3, "items": { "$ref": "https://panoworld-automation.local/schemas/scene_geometry/v1/scene_geometry-1.0.0.schema.json#/$defs/point2" } },
                  "floor_z": { "type": "number" },
                  "ceiling_z": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "walls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "start", "end", "height_m", "thickness_m"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "start": { "$ref": "https://panoworld-automation.local/schemas/scene_geometry/v1/scene_geometry-1.0.0.schema.json#/$defs/point2" },
                  "end": { "$ref": "https://panoworld-automation.local/schemas/scene_geometry/v1/scene_geometry-1.0.0.schema.json#/$defs/point2" },
                  "height_m": { "type": "number", "exclusiveMinimum": 0 },
                  "thickness_m": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "openings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "type", "wall_id", "center", "width_m", "height_m", "sill_m"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["door", "window"] },
                  "wall_id": { "type": "string", "minLength": 1 },
                  "center": { "$ref": "https://panoworld-automation.local/schemas/scene_geometry/v1/scene_geometry-1.0.0.schema.json#/$defs/point2" },
                  "width_m": { "type": "number", "exclusiveMinimum": 0 },
                  "height_m": { "type": "number", "exclusiveMinimum": 0 },
                  "sill_m": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "exports": {
              "type": "object",
              "properties": {
                "blend": { "type": ["string", "null"] },
                "glb": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
