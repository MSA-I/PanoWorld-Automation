{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoworld-automation.local/schemas/input_quality_report/v1/input_quality_report-1.0.0.schema.json",
  "title": "input_quality_report",
  "allOf": [
    { "$ref": "https://panoworld-automation.local/schemas/envelope/v1/envelope-1.0.0.schema.json" },
    {
      "properties": {
        "schema_id": { "const": "input_quality_report" },
        "schema_version": { "const": "1.0.0" },
        "payload": {
          "type": "object",
          "required": ["scale_known", "checks"],
          "properties": {
            "scale_known": { "type": "boolean" },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["check", "result"],
                "properties": {
                  "check": { "type": "string", "minLength": 1 },
                  "result": { "enum": ["pass", "warn", "fail"] },
                  "details": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "blockers": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
